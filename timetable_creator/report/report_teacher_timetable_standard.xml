<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- TEACHER TIMETABLE STANDARD REPORT ACTION -->
    <record id="action_report_teacher_timetable_standard" model="ir.actions.report">
        <field name="name">Teacher Timetables</field>
        <field name="model">time.table</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">timetable_creator.report_teacher_timetable_standard</field>
        <field name="report_file">timetable_creator.report_teacher_timetable_standard</field>
        <field name="print_report_name">'Teacher Timetables'</field>
        <field name="binding_model_id" ref="timetable.model_time_table"/>
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- TEACHER TIMETABLE STANDARD QWEB DEFINITION -->
    <template id="report_teacher_timetable_standard">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="page-break-after: always;">
                        <div class="oe_structure" /><br /><br />
                        
                        <strong style="text-align: center;"><h4>Teacher Timetable</h4></strong><br />
                        
                        <h4 t-field="o.name" />
                        
                        <div class="row" align="center">
                            <table width="100%" style="border: 2px solid black;">
                                <tr style="border: 0px;">
                                    <td colspan="4" style="border: 0px;">
                                        <br />
                                        <table width="100%" style="border: 0px;">
                                            <tr style="border: 0px;">
                                                <td
                                                    width="15%"
                                                    align="center"
                                                    style="font-family: 'Helvetica';font-size: 18px;border: 2px solid black;"
                                                >
                                                    <b>Time</b>
                                                </td>
                                                <td
                                                    align="center"
                                                    width="14.16%"
                                                    style="font-family: 'Helvetica';font-size: 18px;border: 2px solid black;"
                                                >
                                                    <b>Sunday</b>
                                                </td>
                                                <td
                                                    align="center"
                                                    width="14.16%"
                                                    style="font-family: 'Helvetica';font-size: 18px;border: 2px solid black;"
                                                >
                                                    <b>Monday</b>
                                                </td>
                                                <td
                                                    align="center"
                                                    width="14.16%"
                                                    style="font-family: 'Helvetica';font-size: 18px;border: 2px solid black;"
                                                >
                                                    <b>Tuesday</b>
                                                </td>
                                                <td
                                                    align="center"
                                                    width="14.16%"
                                                    style="font-family: 'Helvetica';font-size: 18px;border: 2px solid black;"
                                                >
                                                    <b>Wednesday</b>
                                                </td>
                                                <td
                                                    align="center"
                                                    width="14.16%"
                                                    style="font-family: 'Helvetica';font-size: 18px;border: 2px solid black;"
                                                >
                                                    <b>Thursday</b>
                                                </td>
                                                <td
                                                    align="center"
                                                    width="14.16%"
                                                    style="font-family: 'Helvetica';font-size: 18px;border: 2px solid black;"
                                                >
                                                    <b>Saturday</b>
                                                </td>
                                            </tr>
                                            <t
                                                t-foreach="get_timetable(o, table_docs)"
                                                t-as="t"
                                            >
                                                <tr>
                                                    <td
                                                        align="center"
                                                        width="15%"
                                                        style="font-family: 'Helvetica';font-size: 16px;border: 2px solid black;"
                                                    >
                                                        <span
                                                            t-esc="'{0:,.2f}'.format(t['start_time'])"
                                                        />
                                                        <span> - </span>
                                                        <span
                                                            t-esc="'{0:,.2f}'.format(t['end_time'])"
                                                        />
                                                    </td>
                                                    <td
                                                        align="center"
                                                        width="14.16%"
                                                        style="font-family: 'Helvetica';font-size: 16px;border: 2px solid black;"
                                                    >
                                                        <span
                                                            t-esc="t.get('sunday')" t-options="{'widget': 'text'}"
                                                        />
                                                    </td>
                                                    <td
                                                        align="center"
                                                        width="14.16%"
                                                        style="font-family: 'Helvetica';font-size: 16px;border: 2px solid black;"
                                                    >
                                                        <span
                                                            t-esc="t.get('monday')" t-options="{'widget': 'text'}"
                                                        />
                                                    </td>
                                                    <td
                                                        align="center"
                                                        width="14.16%"
                                                        style="font-family: 'Helvetica';font-size: 16px;border: 2px solid black;"
                                                    >
                                                        <span
                                                            t-esc="t.get('tuesday')" t-options="{'widget': 'text'}"
                                                        />
                                                    </td>
                                                    <td
                                                        align="center"
                                                        width="14.16%"
                                                        style="font-family: 'Helvetica';font-size: 16px;border: 2px solid black;"
                                                    >
                                                        <span
                                                            t-esc="t.get('wednesday')" t-options="{'widget': 'text'}"
                                                        />
                                                    </td>
                                                    <td
                                                        align="center"
                                                        width="14.16%"
                                                        style="font-family: 'Helvetica';font-size: 16px;border: 2px solid black;"
                                                    >
                                                        <span
                                                            t-esc="t.get('thursday')" t-options="{'widget': 'text'}"
                                                        />
                                                    </td>
                                                    <td
                                                        align="center"
                                                        width="14.16%"
                                                        style="font-family: 'Helvetica';font-size: 16px;border: 2px solid black;"
                                                    >
                                                        <span
                                                            t-esc="t.get('saturday')" t-options="{'widget': 'text'}"
                                                        />
                                                    </td>
                                                </tr>
                                            </t>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
