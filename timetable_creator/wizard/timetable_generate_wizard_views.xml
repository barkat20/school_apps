<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_timetable_generate_wizard_form" model="ir.ui.view">
        <field name="name">timetable.generate.wizard.form</field>
        <field name="model">timetable.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Timetable">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <strong>Note:</strong> The Professional Multi-Stage Optimizer has been activated. <br/>
                        When you click Generate, Odoo will freeze with a "Loading" circle. <b>Do not close the page!</b> The AI is calculating millions of permutations and multi-level Swap Chains in the background. Please allow up to 45 seconds for a perfect timetable.
                    </div>
                    <notebook>
                        <page string="General Information">
                            <group>
                                <field name="academic_year_id"/>
                                <field name="academic_stage_id" options="{'no_create': True}"/>
                                <field name="version_name"/>
                            </group>
                        </page>
                        <page string="Scoring Weights Configuration">
                            <group>
                                <group>
                                    <field name="weight_student_gap"/>
                                    <field name="weight_teacher_gap"/>
                                </group>
                                <group>
                                    <field name="weight_daily_balance"/>
                                    <field name="weight_morning_pref"/>
                                </group>
                            </group>
                            <div class="text-muted">
                                Configure the AI's internal scoring mechanisms to enforce your school's unique scheduling policies.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_generate_timetable" string="Generate" type="object" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_timetable_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Timetable</field>
        <field name="res_model">timetable.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_timetable_generate_wizard" 
              name="Generate Timetable" 
              parent="menu_timetable_generation_config" 
              action="action_timetable_generate_wizard" 
              sequence="100"/>

</odoo>
